{
    "name": "quillstack/local-storage",
    "description": "The library to manage files in local storage.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "quillstack",
        "storage",
        "php8",
        "local"
    ],
    "homepage": "https://quillstack.org/packages/local-storage",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "Quillstack\\LocalStorage\\": "src/",
            "Quillstack\\LocalStorage\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "quillstack/storage-interface": "^0.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.9"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    }
}
